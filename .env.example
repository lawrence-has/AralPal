# AralPal – Environment Variables
# Copy this file to .env and fill in real values.
# .env is excluded from Git via .gitignore — never commit it.

# ── Strapi CMS ────────────────────────────────────────────────────────────────
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=your-strapi-api-token-here

# ── PayMongo ──────────────────────────────────────────────────────────────────
# Get these from your PayMongo dashboard → Developers → API Keys
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
# Get this from PayMongo dashboard → Developers → Webhooks → your webhook → Signing Secret
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_signing_secret_here
